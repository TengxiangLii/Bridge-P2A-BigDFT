   }
  },
  "overrides": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "key": {
      "enum": [
       "ladder",
       "rmult",
       "gnrm_cv"
      ]
     },
     "value": {},
     "reason": {
      "type": "string",
      "minLength": 3
     }
    },
    "required": [
     "key",
     "value",
     "reason"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "claims",
  "preset",
  "species",
  "overrides"
 ],
